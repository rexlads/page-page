# Copy this file to .env and adjust the values.

# Port the server listens on
PORT=3000

# Public base URL (used when generating short links in the panel)
BASE_URL=http://localhost:3000

# Secret used to sign the admin login token. CHANGE THIS to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# First-run admin credentials. After first start they are stored (hashed) in the
# database; you can change the password from the panel. Changing them here later
# has no effect unless the database is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Where the SQLite database and uploads live. Everything here is included in an export.
DATA_DIR=./data
